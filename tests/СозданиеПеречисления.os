Процедура СоздатьПеречисление()
	Стр = "<!DOCTYPE html>
	|<html lang=""ru"">
	|<head>
	|    <title>" + ИмяРус + " Перечисление</title>
	|    <meta charset=""UTF-8"">
	|    <link rel=""stylesheet"" type=""text/css"" href=""mainstyle.css"">
	|    <script defer src=""mobilstyle.js""></script>
	|</head>
	|<body id=bodyID class=dtBODY onclick=""divrightClick(event)"">
	|    <div id=nsbanner>
	|        <div id=bannerrow1>
	|            <table class=bannerparthead cellSpacing=0>
	|                <tbody>
	|                    <tr id=hdr>
	|                        <td class=runninghead></td>
	|                        <td class=product></td>
	|                    </tr>
	|                </tbody>
	|            </table>
	|        </div>
	|        <div id=TitleRow>
	|            <h1 class=dtH1>" + ИмяРус + " (" + ИмяEn + ")" + " Перечисление</h1>
	|        </div>
	|    </div>
	|    <div id=nstext>
	|        <h4 class=dtH4>Описание</h4>
	|        <p>" + Описание + "</p>
	|        <h4 class=dtH4>Члены</h4>
	|        <div class=tablediv>
	|            <table class=dtTABLE cellSpacing=0>
	|                <tbody>
	|                    <tr vAlign=top>
	|                        <th width=""38%"">Имя члена</th>
	|                        <th width=""50%"">Описание</th>
	|                        <th width=""12%"">Значение</th>
	|                    </tr>";
	Для А = 0 По М_Параметров.ВГраница() Цикл
